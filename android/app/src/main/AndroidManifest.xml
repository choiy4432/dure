<?xml version="1.0" encoding="utf-8"?>
<!--
  두레 앱 = PC 두레의 휴대폰 화면을 여는 TWA 껍데기. 앱 쪽 주소 선언(asset_statements)은 두지 않는다 —
  PC 마다 주소가 달라 실행 중에 받고, 크롬은 그 주소의 /.well-known/assetlinks.json 만으로 앱을 인정한다(실측 2026-11-09).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dure"
        tools:ignore="DataExtractionRules">

        <!-- 시작 화면(보이는 화면 — 투명한 LauncherActivity 는 안드로이드 17 에서 아무것도 안 했다, 실측) -->
        <activity
            android:name=".StartActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 크롬의 [두레 앱으로 열기](intent://)와 알림 누름으로 PC 주소를 받는다. 자동 확인은 하지 않는다(*.ts.net 전체는 확인할 수 없다) -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*.ts.net" />
            </intent-filter>
        </activity>

        <!-- 웹이 알림 권한을 물으면 앱 이름으로 묻는다 -->
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />

        <!-- 크롬이 웹 알림을 앱에 넘긴다 — 주소 꼬리를 지우고 앱 이름·아이콘으로 올린다. 크롬이 불러야 해서 내보낸다(부른 쪽은 서비스가 크롬 토큰으로 확인한다) -->
        <service
            android:name=".DureDelegationService"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedService">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification_icon" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
