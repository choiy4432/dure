<?xml version="1.0" encoding="utf-8"?>
<!--
  처음 쓰기(시안 app-a) — 기억한 PC 가 없을 때. 크기는 웹 짝 맺기·오프라인 화면과 같은 비율(제목 26sp/34 · 글 15sp/24 · 번호 24sp — 셋 다 글꼴 크기 설정을 따라 커진다).
  위·아래 여백은 StartActivity 가 상태·탐색 막대만큼 더한다. 바탕은 테마(windowBackground). 글 모양은 values/styles.xml(줄 높이는 values-v28)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/first_run_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dure_logo" />

        <TextView
            style="@style/Dure.FirstRun.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/first_title"
            tools:targetApi="p" />

        <TextView
            style="@style/Dure.FirstRun.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/first_body" />

        <!-- 번호 줄(first_run_step.xml) — StartActivity 가 first_steps 의 순서대로 넣는다. 줄 사이는 16dp(웹 .pr-steps 의 gap) -->
        <LinearLayout
            android:id="@+id/first_run_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:divider="@drawable/gap_16"
            android:orientation="vertical"
            android:showDividers="middle" />
    </LinearLayout>
</ScrollView>
